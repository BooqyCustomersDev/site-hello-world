# Inget behövs här för att komma igång: npm run dev läser booqy.json (dev).
# Kopiera till .env.local bara för att avvika från den. .env.local är
# git-ignorerad. Allt som börjar med VITE_ hamnar i den publika JS-bundeln:
# aldrig hemligheter här.

# Ett annat API än booqy.json:s (t.ex. lokalt).
# VITE_API_BASE_URL=

# En annan restaurang i dev än repots egen (slug i Booqy Console).
# VITE_DEV_TENANT_SLUG=

# CDN för menybilder.
# VITE_MENU_IMAGE_BASE_URL=
